# 이 파일을 .env 로 복사해 키를 채운다. .env 는 저장소에 올리지 않는다(.gitignore).
OPENAI_API_KEY=

# 선택: 모델을 바꾸고 싶을 때 (기본값은 교안과 같은 등급)
# ROUTE_MODEL=gpt-5.6-luna
# ANSWER_MODEL=gpt-5.6-terra
# JUDGE_MODEL=gpt-5.6-terra
# 교안 모델은 추론 모드와 도구 호출을 함께 못 써서 기본값이 none 이다.
# 다른 모델을 쓰면 아래를 빈 값으로 두어 이 인자를 넘기지 않게 한다.
# ANSWER_REASONING=
